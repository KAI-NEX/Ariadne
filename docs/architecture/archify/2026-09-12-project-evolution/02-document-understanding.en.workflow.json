  "cards": [
    { "dot": "violet", "title": "Why So Many GitHub Projects Were Compared", "items": ["SmartResume: separate extraction from source scope", "RAGFlow: choose native text or OCR per page", "Docling: borrow typed IR and provenance, not the dependency"] },
    { "dot": "amber", "title": "Why We Stopped Adding Engines", "items": ["Paddle took about 725.6 s/page and 4 GB RSS with no entity gain", "Surya produced no comparable result and added runtime/license boundaries", "Global GapTree and blind native/OCR fusion caused real regressions"] },
    { "dot": "emerald", "title": "Final Stop Conditions", "items": ["20 files and 305 pages completed; 6/6 truth documents passed", "18 reviewable, 2 safely routed to humans, 0 crashes", "No repeated real failure, so OCR architecture research stopped"] }
