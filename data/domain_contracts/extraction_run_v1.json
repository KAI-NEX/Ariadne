{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job-radar-career-extraction-run-v1",
  "title": "Job Radar Career Extraction Run v1",
  "type": "object",
  "required": [
    "extraction_run_id",
    "source_document_id",
    "document_type",
    "extractor_version",
    "input_content_hash",
    "status",
    "entity_count",
    "warnings",
    "model_call_made"
  ],
  "properties": {
    "extraction_run_id": { "type": "string", "minLength": 1 },
    "source_document_id": { "type": "string", "minLength": 1 },
    "document_type": { "enum": ["resume", "portfolio", "project_description", "other"] },
    "extractor_version": { "type": "string" },
    "input_content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["needs_review", "needs_manual_selection", "needs_visual_extraction", "failed"] },
    "entity_count": { "type": "integer", "minimum": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "model_call_made": { "type": "boolean" }
  },
  "additionalProperties": true
}
